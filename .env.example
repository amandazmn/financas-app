# Fonte de dados: "demo" (dados fictícios, padrão) ou "pluggy" (suas contas reais via Meu Pluggy)
DATA_SOURCE=demo

# --- Só para DATA_SOURCE=pluggy ---
# Credenciais da sua aplicação em https://dashboard.pluggy.ai
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# IDs dos "items" (conexões) pessoais, separados por vírgula. Aparecem no Meu Pluggy / dashboard da Pluggy.
PLUGGY_ITEM_IDS=
# Item da conta da empresa (MEI), opcional
PLUGGY_BUSINESS_ITEM_ID=
# Transações a partir desta data
PLUGGY_FROM=2026-01-01

# Senha para abrir o app no modo real (obrigatória quando DATA_SOURCE=pluggy)
APP_PASSWORD=

# Para categorizar sua renda e transferências entre suas contas (não versione valores reais)
OWNER_NAME=
OWNER_CNPJ=
